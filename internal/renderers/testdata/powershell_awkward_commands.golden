function brace {
    $__aliasdeck_cmd = 'Get-Process | Where-Object { $_.CPU -gt 10 }'
    & ([scriptblock]::Create($__aliasdeck_cmd + ' @args')) @args
}

# Nested and unbalanced quotes
function gwip {
    $__aliasdeck_cmd = 'git commit -m ''wip: don''t ask'''
    & ([scriptblock]::Create($__aliasdeck_cmd + ' @args')) @args
}

# Backtick and expansion must stay literal in the file
function reload {
    $__aliasdeck_cmd = '& "$HOME/reload.ps1" `-Force'
    & ([scriptblock]::Create($__aliasdeck_cmd + ' @args')) @args
}
